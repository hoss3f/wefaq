DATABASE_URL=postgresql://user:password@localhost:5432/wefaq
SECRET_KEY=change-me

# SMTP settings for the welcome email sent when an applicant completes their application
# (see send_welcome_email in backend/utils.py). Leave unset to skip sending silently.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=app-password
SMTP_FROM=your-account@gmail.com
